{
  "name": "@devloggers/import-export",
  "version": "0.0.1",
  "description": "Shared Excel import/export utilities for ERP",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('./dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@devloggers/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3"
  }
}
