{
    "name": "@devloggers/api-contracts",
    "version": "0.0.1",
    "description": "Database package with Prisma schema and generated client",
    "main": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js",
            "require": "./dist/src/index.js"
        },
        "./types": {
            "types": "./types/index.ts",
            "import": "./types/index.ts",
            "require": "./types/index.ts"
        }
    },
    "scripts": {
        "dev": "tsc --watch",
        "build": "tsc",
        "clean": "node -e \"require('fs').rmSync('./dist', { recursive: true, force: true })\"",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@devloggers/db-prisma": "workspace:*",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@devloggers/typescript-config": "workspace:*",
        "@types/node": "^22.0.0",
        "prisma": "^6.7.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.3",
        "vitest": "^4.1.8"
    }
}