// ─── Account Type Enum ────────────────────────────────────────────────────────
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

// ─── Journal Entry Status Enum ────────────────────────────────────────────────
enum JournalEntryStatus {
  DRAFT
  POSTED
}

// ─── Chart Of Accounts ───────────────────────────────────────────────────────
model ChartOfAccount {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  code           String
  name           Json        @db.JsonB // LocalizedString: { ar: string; en?: string }
  type           AccountType
  parentId       String?     @map("parent_id")
  isActive       Boolean     @default(true) @map("is_active")
  /// Denormalized cached balance for fast reads.
  /// Source of truth is JournalLine rows — this field is updated by application
  /// logic after every posted JournalEntry. Never write to it directly from ad-hoc queries.
  currentBalance Decimal     @default(0) @map("current_balance") @db.Decimal(18, 4)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  tenant                        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent                        ChartOfAccount?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children                      ChartOfAccount[]   @relation("AccountHierarchy")
  journalLines                  JournalLine[]
  expenseItems                  ExpenseItem[]      @relation("ExpenseItemAccount")
  linkedCashboxes               Cashbox[]          @relation("CashboxLinkedAccount")
  // FinancialSetting back-relations (GL mapping)
  defaultSalesFor               FinancialSetting[] @relation("DefaultSalesAccount")
  defaultPurchaseFor            FinancialSetting[] @relation("DefaultPurchaseAccount")
  defaultTaxFor                 FinancialSetting[] @relation("DefaultTaxAccount")
  defaultReceivableFor          FinancialSetting[] @relation("DefaultReceivableAccount")
  defaultPayableFor             FinancialSetting[] @relation("DefaultPayableAccount")
  defaultInventoryFor           FinancialSetting[] @relation("DefaultInventoryAccount")
  defaultCogsFor                FinancialSetting[] @relation("DefaultCogsAccount")
  defaultInventoryAdjustmentFor FinancialSetting[] @relation("DefaultInventoryAdjustmentAccount")
  defaultOpeningEquityFor       FinancialSetting[] @relation("DefaultOpeningEquityAccount")
  // Party-level override back-relations
  partyReceivables              Party[]            @relation("PartyReceivableAccount")
  partyPayables                 Party[]            @relation("PartyPayableAccount")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("chart_of_accounts")
}

// ─── Journal Entry ────────────────────────────────────────────────────────────
model JournalEntry {
  id             String             @id @default(uuid())
  tenantId       String             @map("tenant_id")
  number         String
  date           DateTime
  fiscalPeriodId String             @map("fiscal_period_id")
  referenceType  String?            @map("reference_type") // e.g. "invoice", "payment"
  referenceId    String?            @map("reference_id")
  description    String?
  status         JournalEntryStatus @default(DRAFT)
  /// Exchange rate to tenant base currency locked at posting time.
  exchangeRate   Decimal            @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  postedAt       DateTime?          @map("posted_at")
  createdBy      String             @map("created_by")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalPeriod FiscalPeriod  @relation(fields: [fiscalPeriodId], references: [id])
  lines        JournalLine[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("journal_entries")
}

// ─── Journal Line ─────────────────────────────────────────────────────────────
model JournalLine {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  journalEntryId String  @map("journal_entry_id")
  accountId      String  @map("account_id")
  partyId        String? @map("party_id")
  debit          Decimal @default(0) @db.Decimal(18, 4)
  credit         Decimal @default(0) @db.Decimal(18, 4)
  description    String?
  sortOrder      Int     @default(0) @map("sort_order")

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id])
  party        Party?         @relation("JournalLineParty", fields: [partyId], references: [id])

  @@index([tenantId])
  @@index([journalEntryId])
  @@map("journal_lines")
}

// ─── Message Role Enum ────────────────────────────────────────────────────────
enum MessageRole {
  USER
  ASSISTANT
}

// ─── AI Chat Session ─────────────────────────────────────────────────────────
model AiChatSession {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages AiChatMessage[]

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("ai_chat_sessions")
}

// ─── AI Chat Message ──────────────────────────────────────────────────────────
model AiChatMessage {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  sessionId String      @map("session_id")
  role      MessageRole
  content   String
  createdAt DateTime    @default(now()) @map("created_at")

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sessionId])
  @@map("ai_chat_messages")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────
/// ⚠ POLYMORPHIC RELATION — entityType + entityId identify the audited record.
/// Prisma cannot enforce a foreign key on a polymorphic field.
/// CASCADE DELETION must be handled at the APPLICATION LAYER (or via DB trigger):
/// when any entity (Invoice, Payment, Expense, etc.) is hard-deleted, the
/// corresponding AuditLog rows must be deleted in the same transaction.
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  action     String // e.g. CREATE, UPDATE, DELETE, POST, CANCEL
  entityType String   @map("entity_type") // e.g. "invoice", "payment"
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

// ─── Brand ────────────────────────────────────────────────────────────────────
model Brand {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  imageUrl  String?  @map("image_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  Item[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("brands")
}

// ─── Payment Type Enum ────────────────────────────────────────────────────────
enum PaymentType {
  RECEIPT
  PAYMENT
  ADJUSTMENT
}

// ─── Payment Status Enum ──────────────────────────────────────────────────────
enum PaymentStatus {
  DRAFT
  POSTED
  CANCELLED
}

// ─── Cashbox ──────────────────────────────────────────────────────────────────
model Cashbox {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  code       String
  name       Json     @db.JsonB // LocalizedString: { ar: string; en?: string }
  currencyId String   @map("currency_id")
  balance    Decimal  @default(0) @db.Decimal(18, 4)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currency        Currency        @relation(fields: [currencyId], references: [id])
  linkedAccountId String?         @map("linked_account_id")
  linkedAccount   ChartOfAccount? @relation("CashboxLinkedAccount", fields: [linkedAccountId], references: [id])
  expenses        Expense[]
  payments        Payment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("cashboxes")
}

// ─── Payment ──────────────────────────────────────────────────────────────────
model Payment {
  id                String        @id @default(uuid())
  tenantId          String        @map("tenant_id")
  number            String
  type              PaymentType
  date              DateTime
  cashboxId         String        @map("cashbox_id")
  partyId           String?       @map("party_id")
  currencyId        String        @map("currency_id")
  /// Exchange rate of the payment currency to tenant base currency, locked at posting time.
  exchangeRate      Decimal       @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  fiscalPeriodId    String        @map("fiscal_period_id")
  amount            Decimal       @db.Decimal(18, 4)
  allocatedAmount   Decimal       @default(0) @map("allocated_amount") @db.Decimal(18, 4)
  unallocatedAmount Decimal       @default(0) @map("unallocated_amount") @db.Decimal(18, 4)
  status            PaymentStatus @default(DRAFT)
  notes             String?
  postedAt          DateTime?     @map("posted_at")
  postedBy          String?       @map("posted_by")
  cancelledAt       DateTime?     @map("cancelled_at")
  cancelledBy       String?       @map("cancelled_by")
  createdBy         String        @map("created_by")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashbox      Cashbox             @relation(fields: [cashboxId], references: [id])
  party        Party?              @relation(fields: [partyId], references: [id])
  currency     Currency            @relation(fields: [currencyId], references: [id])
  fiscalPeriod FiscalPeriod        @relation(fields: [fiscalPeriodId], references: [id])
  allocations  PaymentAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("payments")
}

// ─── Payment Allocation ───────────────────────────────────────────────────────
model PaymentAllocation {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  paymentId String   @map("payment_id")
  invoiceId String   @map("invoice_id")
  amount    Decimal  @db.Decimal(18, 4)
  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([paymentId])
  @@map("payment_allocations")
}

// ─── CatalogEntity ────────────────────────────────────────────────────────────
model CatalogEntity {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  name       String
  kind       String
  parentId   String?  @map("parent_id")
  attributes Json?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    CatalogEntity?      @relation("CatalogHierarchy", fields: [parentId], references: [id])
  children  CatalogEntity[]     @relation("CatalogHierarchy")
  itemLinks ItemCatalogEntity[]

  @@index([tenantId])
  @@index([tenantId, kind])
  @@index([tenantId, parentId])
  @@map("catalog_entities")
}

// ─── Currency ─────────────────────────────────────────────────────────────────
model Currency {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String // e.g. SYP, USD
  name      Json     @db.JsonB // LocalizedString: { ar: string; en?: string }
  symbol    Json?    @db.JsonB // LocalizedString: { ar: string; en?: string }
  isBase    Boolean  @default(false) @map("is_base")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashboxes      Cashbox[]
  invoices       Invoice[]
  payments       Payment[]
  baseForTenants Tenant[]  @relation("TenantBaseCurrency")
  expenses       Expense[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("currencies")
}

enum FieldType {
  TEXT
  DATE
  NUMBER
  SELECT
  BOOLEAN
  MULTI_SELECT
  FILE
}

model CustomField {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  module       String
  name         Json      @db.JsonB // LocalizedString: { ar: string; en?: string }
  label        Json      @db.JsonB // LocalizedString: { ar: string; en?: string }
  type         FieldType
  defaultValue String?   @map("default_value")
  placeholder  Json?     @db.JsonB // LocalizedString: { ar: string; en?: string }
  options      String[]
  isRequired   Boolean   @default(false) @map("is_required")
  showInList   Boolean   @default(false) @map("show_in_list")
  createdAt    DateTime  @default(now()) @map("created_at")

  values CustomFieldValue[]

  @@index([tenantId, module])
  @@map("custom_fields")
}

/// ⚠ POLYMORPHIC RELATION — entityType + entityId identify the owner record.
/// Prisma cannot enforce a foreign key on a polymorphic field.
/// CASCADE DELETION must be handled at the APPLICATION LAYER (or via DB trigger):
/// when any entity (Item, Party, Invoice, etc.) is deleted, the matching
/// CustomFieldValue rows must be deleted in the same transaction.
model CustomFieldValue {
  id         String @id @default(uuid())
  tenantId   String @map("tenant_id")
  fieldId    String @map("field_id")
  entityType String @map("entity_type")
  entityId   String @map("entity_id")
  value      String

  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fieldId, entityId])
  @@index([tenantId, entityType, entityId])
  @@index([fieldId, value])
  @@map("custom_field_values")
}

// ─── Document Sequence ────────────────────────────────────────────────────────
model DocumentSequence {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  documentType String   @map("document_type") // e.g. "PURCHASE_INVOICE", "SALES_INVOICE", "PAYMENT"
  prefix       String // e.g. "PUR", "SAL", "PAY"
  nextNumber   Int      @default(1) @map("next_number")
  padding      Int      @default(5) // zero-pad length, e.g. 5 → 00001
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultSalesForTenants Tenant[] @relation("TenantDefaultSalesSequence")

  @@unique([tenantId, documentType])
  @@index([tenantId])
  @@map("document_sequences")
}

// ─── Expense Status Enum ──────────────────────────────────────────────────────
enum ExpenseStatus {
  DRAFT
  POSTED
  CANCELLED
}

// ─── Expense ──────────────────────────────────────────────────────────────────
model Expense {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  number         String
  date           DateTime
  cashboxId      String        @map("cashbox_id")
  currencyId     String        @map("currency_id")
  /// Exchange rate of the expense currency to tenant base currency, locked at posting time.
  exchangeRate   Decimal       @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  fiscalPeriodId String        @map("fiscal_period_id")
  totalAmount    Decimal       @default(0) @map("total_amount") @db.Decimal(18, 4)
  status         ExpenseStatus @default(DRAFT)
  notes          String?
  journalEntryId String?       @map("journal_entry_id")
  postedAt       DateTime?     @map("posted_at")
  postedBy       String?       @map("posted_by")
  cancelledAt    DateTime?     @map("cancelled_at")
  cancelledBy    String?       @map("cancelled_by")
  createdBy      String        @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashbox      Cashbox       @relation(fields: [cashboxId], references: [id])
  currency     Currency      @relation(fields: [currencyId], references: [id])
  fiscalPeriod FiscalPeriod  @relation(fields: [fiscalPeriodId], references: [id])
  items        ExpenseItem[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("expenses")
}

// ─── Expense Item ─────────────────────────────────────────────────────────────
model ExpenseItem {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  expenseId   String  @map("expense_id")
  accountId   String  @map("account_id")
  description String
  amount      Decimal @db.Decimal(18, 4)
  notes       String?
  sortOrder   Int     @default(0) @map("sort_order")

  expense Expense        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  account ChartOfAccount @relation("ExpenseItemAccount", fields: [accountId], references: [id])

  @@index([tenantId])
  @@index([expenseId])
  @@map("expense_items")
}

model File {
  id           String   @id @default(uuid())
  tenantId     String
  originalName String
  mimeType     String
  size         Int
  extension    String?
  folder       String
  path         String   @unique
  url          String
  checksum     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@map("files")
}

// ─── Financial Setting ────────────────────────────────────────────────────────
// Maps system-level accounting events to their default GL accounts per tenant.
// One row per tenant (1-to-1 with Tenant). All account fields are optional —
// they must be configured before posting transactions that need them.
model FinancialSetting {
  id                                  String   @id @default(uuid())
  tenantId                            String   @unique @map("tenant_id")
  defaultSalesAccountId               String?  @map("default_sales_account_id")
  defaultPurchaseAccountId            String?  @map("default_purchase_account_id")
  defaultTaxAccountId                 String?  @map("default_tax_account_id")
  defaultReceivableAccountId          String?  @map("default_receivable_account_id")
  defaultPayableAccountId             String?  @map("default_payable_account_id")
  defaultInventoryAccountId           String?  @map("default_inventory_account_id")
  defaultCogsAccountId                String?  @map("default_cogs_account_id")
  defaultInventoryAdjustmentAccountId String?  @map("default_inventory_adjustment_account_id")
  defaultOpeningEquityAccountId       String?  @map("default_opening_equity_account_id")
  createdAt                           DateTime @default(now()) @map("created_at")
  updatedAt                           DateTime @updatedAt @map("updated_at")

  tenant                            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultSalesAccount               ChartOfAccount? @relation("DefaultSalesAccount", fields: [defaultSalesAccountId], references: [id])
  defaultPurchaseAccount            ChartOfAccount? @relation("DefaultPurchaseAccount", fields: [defaultPurchaseAccountId], references: [id])
  defaultTaxAccount                 ChartOfAccount? @relation("DefaultTaxAccount", fields: [defaultTaxAccountId], references: [id])
  defaultReceivableAccount          ChartOfAccount? @relation("DefaultReceivableAccount", fields: [defaultReceivableAccountId], references: [id])
  defaultPayableAccount             ChartOfAccount? @relation("DefaultPayableAccount", fields: [defaultPayableAccountId], references: [id])
  defaultInventoryAccount           ChartOfAccount? @relation("DefaultInventoryAccount", fields: [defaultInventoryAccountId], references: [id])
  defaultCogsAccount                ChartOfAccount? @relation("DefaultCogsAccount", fields: [defaultCogsAccountId], references: [id])
  defaultInventoryAdjustmentAccount ChartOfAccount? @relation("DefaultInventoryAdjustmentAccount", fields: [defaultInventoryAdjustmentAccountId], references: [id])
  defaultOpeningEquityAccount       ChartOfAccount? @relation("DefaultOpeningEquityAccount", fields: [defaultOpeningEquityAccountId], references: [id])

  @@index([tenantId])
  @@map("financial_settings")
}

// ─── Fiscal Period ────────────────────────────────────────────────────────────
model FiscalPeriod {
  id        String             @id @default(uuid())
  tenantId  String             @map("tenant_id")
  name      String // e.g. "2026", "Q1 2026"
  startDate DateTime           @map("start_date")
  endDate   DateTime           @map("end_date")
  status    FiscalPeriodStatus @default(OPEN)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  invoices       Invoice[]
  payments       Payment[]
  journalEntries JournalEntry[]
  stockCounts    StockCount[]
  expenses       Expense[]

  @@index([tenantId])
  @@map("fiscal_periods")
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

// ─── Invoice Direction Enum ───────────────────────────────────────────────────
enum InvoiceDirection {
  PURCHASE
  SALE
}

// ─── Invoice Status Enum ──────────────────────────────────────────────────────
enum InvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

// ─── Invoice Type ─────────────────────────────────────────────────────────────
model InvoiceType {
  id           String           @id @default(uuid())
  tenantId     String           @map("tenant_id")
  code         String
  name         Json             @db.JsonB // LocalizedString: { ar: string; en?: string }
  direction    InvoiceDirection
  affectsStock Boolean          @default(true) @map("affects_stock")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("invoice_types")
}

// ─── Invoice ──────────────────────────────────────────────────────────────────
model Invoice {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  invoiceTypeId  String        @map("invoice_type_id")
  number         String
  date           DateTime
  dueDate        DateTime?     @map("due_date")
  partyId        String        @map("party_id")
  warehouseId    String?       @map("warehouse_id")
  fiscalPeriodId String        @map("fiscal_period_id")
  currencyId     String        @map("currency_id")
  /// Exchange rate of the invoice currency to tenant base currency, locked at posting time.
  exchangeRate   Decimal       @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @default(0) @db.Decimal(18, 4)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(18, 4)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(18, 4)
  total          Decimal       @default(0) @db.Decimal(18, 4)
  notes          String?
  postedAt       DateTime?     @map("posted_at")
  postedBy       String?       @map("posted_by")
  cancelledAt    DateTime?     @map("cancelled_at")
  cancelledBy    String?       @map("cancelled_by")
  createdBy      String        @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceType        InvoiceType         @relation(fields: [invoiceTypeId], references: [id])
  party              Party               @relation(fields: [partyId], references: [id])
  warehouse          Warehouse?          @relation(fields: [warehouseId], references: [id])
  fiscalPeriod       FiscalPeriod        @relation(fields: [fiscalPeriodId], references: [id])
  currency           Currency            @relation(fields: [currencyId], references: [id])
  lines              InvoiceLine[]
  paymentAllocations PaymentAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("invoices")
}

// ─── Invoice Line ─────────────────────────────────────────────────────────────
model InvoiceLine {
  id              String  @id @default(uuid())
  tenantId        String  @map("tenant_id")
  invoiceId       String  @map("invoice_id")
  itemId          String  @map("item_id")
  unitId          String  @map("unit_id")
  quantity        Decimal @db.Decimal(18, 4)
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 4)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal @default(0) @map("discount_amount") @db.Decimal(18, 4)
  taxPercent      Decimal @default(0) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount       Decimal @default(0) @map("tax_amount") @db.Decimal(18, 4)
  total           Decimal @db.Decimal(18, 4)
  notes           String?
  sortOrder       Int     @default(0) @map("sort_order")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_lines")
}

// ─── ItemCatalogEntity ────────────────────────────────────────────────────────
model ItemCatalogEntity {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  itemId          String   @map("item_id")
  catalogEntityId String   @map("catalog_entity_id")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  catalogEntity CatalogEntity @relation(fields: [catalogEntityId], references: [id], onDelete: Cascade)

  @@unique([tenantId, itemId, catalogEntityId])
  @@index([tenantId, itemId])
  @@index([tenantId, catalogEntityId])
  @@map("item_catalog_entities")
}

// ─── Item Category ───────────────────────────────────────────────────────────
model ItemCategory {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  imageUrl    String?  @map("image_url")
  parentId    String?  @map("parent_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   ItemCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ItemCategory[] @relation("CategoryHierarchy")
  items    Item[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("item_categories")
}

enum RelationType {
  compatible_with
  replaces
  requires
}

// ─── ItemRelation ─────────────────────────────────────────────────────────────
model ItemRelation {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  itemId        String       @map("item_id")
  relatedItemId String       @map("related_item_id")
  relationType  RelationType @map("relation_type")
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item        Item   @relation("ItemRelations", fields: [itemId], references: [id], onDelete: Cascade)
  relatedItem Item   @relation("ItemRelatedTo", fields: [relatedItemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, itemId, relatedItemId, relationType])
  @@index([tenantId, itemId])
  @@index([tenantId, relatedItemId])
  @@map("item_relations")
}

enum ItemType {
  product
  service
}

// ─── Item ─────────────────────────────────────────────────────────────────────
model Item {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  code                String
  name                String
  barcode             String?
  categoryId          String   @map("category_id")
  baseUnitId          String   @map("base_unit_id")
  brandId             String?  @map("brand_id")
  defaultSellingPrice Decimal? @map("default_selling_price") @db.Decimal(18, 4)
  latestPurchasePrice Decimal? @map("latest_purchase_price") @db.Decimal(18, 4)
  mainImageUrl        String?  @map("main_image_url")

  description String?
  note        String?

  galleryUrls String[] @map("gallery_urls")
  itemType    ItemType @default(product) @map("item_type")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category            ItemCategory        @relation(fields: [categoryId], references: [id])
  baseUnit            Unit                @relation(fields: [baseUnitId], references: [id])
  brand               Brand?              @relation(fields: [brandId], references: [id])
  warehouseItems      WarehouseItem[]
  stockBalances       StockBalance[]
  stockMovements      StockMovement[]
  invoiceLines        InvoiceLine[]
  stockCountLines     StockCountLine[]
  itemRelations       ItemRelation[]      @relation("ItemRelations")
  itemRelatedTo       ItemRelation[]      @relation("ItemRelatedTo")
  itemCatalogEntities ItemCatalogEntity[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, itemType])
  @@index([tenantId, brandId])
  @@map("items")
}

// ─── Party ─────────────────────────────────────────────────────────────────────
enum PartyType {
  CUSTOMER
  SUPPLIER
  CUSTOMER_SUPPLIER
}

model Party {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  code                String?
  name                String
  type                PartyType
  phone               String?
  email               String?
  address             String?
  openingBalance      Decimal   @default(0) @map("opening_balance") @db.Decimal(18, 4)
  isActive            Boolean   @default(true) @map("is_active")
  receivableAccountId String?   @map("receivable_account_id")
  payableAccountId    String?   @map("payable_account_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices          Invoice[]
  payments          Payment[]
  journalLines      JournalLine[]   @relation("JournalLineParty")
  receivableAccount ChartOfAccount? @relation("PartyReceivableAccount", fields: [receivableAccountId], references: [id])
  payableAccount    ChartOfAccount? @relation("PartyPayableAccount", fields: [payableAccountId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, type])
  @@map("parties")
}

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/client"
}

// ─── Stock Count Status Enum ──────────────────────────────────────────────────
enum StockCountStatus {
  DRAFT
  POSTED
  CANCELLED
}

// ─── Stock Count ──────────────────────────────────────────────────────────────
model StockCount {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  number   String

  date           DateTime
  warehouseId    String           @map("warehouse_id")
  fiscalPeriodId String           @map("fiscal_period_id")
  status         StockCountStatus @default(DRAFT)
  notes          String?
  postedAt       DateTime?        @map("posted_at")
  postedBy       String?          @map("posted_by")
  createdBy      String           @map("created_by")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id])
  fiscalPeriod FiscalPeriod     @relation(fields: [fiscalPeriodId], references: [id])
  lines        StockCountLine[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("stock_counts")
}

// ─── Stock Count Line ─────────────────────────────────────────────────────────
model StockCountLine {
  id              String  @id @default(uuid())
  tenantId        String  @map("tenant_id")
  stockCountId    String  @map("stock_count_id")
  itemId          String  @map("item_id")
  systemQuantity  Decimal @map("system_quantity") @db.Decimal(18, 4)
  countedQuantity Decimal @map("counted_quantity") @db.Decimal(18, 4)
  difference      Decimal @db.Decimal(18, 4)
  notes           String?

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id])

  @@index([tenantId])
  @@index([stockCountId])
  @@map("stock_count_lines")
}

// ─── Stock Movement Type ──────────────────────────────────────────────────────
enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  ADJUSTMENT
  STOCK_COUNT
  TRANSFER_IN
  TRANSFER_OUT
}

// ─── Stock Balance (projection table for fast reads) ─────────────────────────
model StockBalance {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  warehouseId String   @map("warehouse_id")
  itemId      String   @map("item_id")
  quantity    Decimal  @default(0) @db.Decimal(18, 4)
  averageCost Decimal  @default(0) @map("average_cost") @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, warehouseId, itemId])
  @@index([tenantId])
  @@map("stock_balances")
}

// ─── Stock Movement (source of truth ledger) ─────────────────────────────────
model StockMovement {
  id             String            @id @default(uuid())
  tenantId       String            @map("tenant_id")
  warehouseId    String            @map("warehouse_id")
  itemId         String            @map("item_id")
  fiscalPeriodId String            @map("fiscal_period_id")
  movementType   StockMovementType @map("movement_type")
  quantity       Decimal           @db.Decimal(18, 4)
  unitCost       Decimal           @default(0) @map("unit_cost") @db.Decimal(18, 4)
  referenceType  String?           @map("reference_type") // e.g. "invoice", "stock_count"
  referenceId    String?           @map("reference_id")
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  createdBy      String            @map("created_by")

  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  item         Item         @relation(fields: [itemId], references: [id])
  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id])

  @@index([tenantId])
  @@index([tenantId, itemId])
  @@index([tenantId, warehouseId])
  @@map("stock_movements")
}

// ─── TagAssignment ────────────────────────────────────────────────────────────
/// ⚠ POLYMORPHIC RELATION — entityType + entityId identify the tagged record.
/// Prisma cannot enforce a foreign key on a polymorphic field.
/// CASCADE DELETION must be handled at the APPLICATION LAYER (or via DB trigger):
/// when any entity (Item, Party, Invoice, Warehouse, etc.) is deleted, the
/// corresponding TagAssignment rows must be deleted in the same transaction.
model TagAssignment {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  tagId      String   @map("tag_id")
  entityType String   @map("entity_type") // "item" | "party" | "invoice" | "warehouse"
  entityId   String   @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, entityType, entityId])
  @@index([tenantId, entityType, entityId])
  @@map("tag_assignments")
}

// ─── Tag ──────────────────────────────────────────────────────────────────────
model Tag {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  color     String?
  module    String // "items" | "parties" | "invoices" | "warehouses"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments TagAssignment[]

  @@unique([tenantId, name, module])
  @@index([tenantId, module])
  @@map("tags")
}

// ─── Tenant Setting ───────────────────────────────────────────────────────────
model TenantSetting {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  category  String // 'localization' | 'financial' | 'documents'
  key       String // registry key, e.g. 'timezone'
  value     Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, category])
  @@map("tenant_settings")
}

// ─── Tenant ───────────────────────────────────────────────────────────────────
model Tenant {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  address   String?
  phone     String?
  email     String?
  logo      String?
  legalName String? @map("legal_name")
  taxNumber String? @map("tax_number")
  website   String?

  baseCurrencyId         String? @map("base_currency_id")
  defaultSalesSequenceId String? @map("default_sales_sequence_id")

  isActive              Boolean   @default(true) @map("is_active")
  onboardingStep        Int       @default(0) @map("onboarding_step")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  users                AppUser[]
  roles                Role[]
  currencies           Currency[]
  fiscalPeriods        FiscalPeriod[]
  documentSequences    DocumentSequence[]
  itemCategories       ItemCategory[]
  units                Unit[]
  items                Item[]
  parties              Party[]
  warehouses           Warehouse[]
  cashboxes            Cashbox[]
  invoiceTypes         InvoiceType[]
  invoices             Invoice[]
  payments             Payment[]
  chartOfAccounts      ChartOfAccount[]
  journalEntries       JournalEntry[]
  stockCounts          StockCount[]
  auditLogs            AuditLog[]
  aiChatSessions       AiChatSession[]
  baseCurrency         Currency?           @relation("TenantBaseCurrency", fields: [baseCurrencyId], references: [id])
  defaultSalesSequence DocumentSequence?   @relation("TenantDefaultSalesSequence", fields: [defaultSalesSequenceId], references: [id])
  settings             TenantSetting[]
  financialSetting     FinancialSetting?
  expenses             Expense[]
  tags                 Tag[]
  itemRelations        ItemRelation[]
  catalogEntities      CatalogEntity[]
  itemCatalogEntities  ItemCatalogEntity[]
  brands               Brand[]

  @@map("tenants")
}

// ─── Unit ─────────────────────────────────────────────────────────────────────
model Unit {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  abbreviation String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items        Item[]
  invoiceLines InvoiceLine[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("units")
}

// ─── App User ─────────────────────────────────────────────────────────────────
model AppUser {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  email        String
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("app_users")
}

// ─── Role ─────────────────────────────────────────────────────────────────────
model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        Json     @db.JsonB // LocalizedString: { ar: string; en?: string }
  description Json?    @db.JsonB // LocalizedString: { ar: string; en?: string }
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  // Note: unique on (tenantId, name->>'ar') enforced via expression index in migration SQL
  @@index([tenantId])
  @@map("roles")
}

// ─── User Role (join table) ──────────────────────────────────────────────────
model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ─── Warehouse ────────────────────────────────────────────────────────────────
model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseItems WarehouseItem[]
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  invoices       Invoice[]
  stockCounts    StockCount[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

// ─── Warehouse Item ───────────────────────────────────────────────────────────
model WarehouseItem {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  warehouseId String   @map("warehouse_id")
  itemId      String   @map("item_id")
  minQuantity Decimal? @map("min_quantity") @db.Decimal(18, 4)
  maxQuantity Decimal? @map("max_quantity") @db.Decimal(18, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, itemId])
  @@index([tenantId])
  @@map("warehouse_items")
}
