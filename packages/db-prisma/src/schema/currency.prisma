// ─── Currency ─────────────────────────────────────────────────────────────────
model Currency {
    id        String   @id @default(uuid())
    tenantId  String   @map("tenant_id")
    code      String   // e.g. SYP, USD
    name      Json     @db.JsonB // LocalizedString: { ar: string; en?: string }
    symbol    Json?    @db.JsonB // LocalizedString: { ar: string; en?: string }
    isBase    Boolean  @default(false) @map("is_base")
    isActive  Boolean  @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    cashboxes Cashbox[]
    invoices  Invoice[]
    payments  Payment[]
    baseForTenants Tenant[] @relation("TenantBaseCurrency")
    expenses Expense[]

    @@unique([tenantId, code])
    @@index([tenantId])
    @@map("currencies")
}
