// ─── Payment Type Enum ────────────────────────────────────────────────────────
enum PaymentType {
    RECEIPT
    PAYMENT
    ADJUSTMENT
}

// ─── Payment Status Enum ──────────────────────────────────────────────────────
enum PaymentStatus {
    DRAFT
    POSTED
    CANCELLED
}

// ─── Cashbox ──────────────────────────────────────────────────────────────────
model Cashbox {
    id         String   @id @default(uuid())
    tenantId   String   @map("tenant_id")
    code       String
    name       Json     @db.JsonB // LocalizedString: { ar: string; en?: string }
    currencyId String   @map("currency_id")
    balance    Decimal  @default(0) @db.Decimal(18, 4)
    isActive   Boolean  @default(true) @map("is_active")
    createdAt  DateTime @default(now()) @map("created_at")
    updatedAt  DateTime @updatedAt @map("updated_at")

    tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    currency Currency  @relation(fields: [currencyId], references: [id])
    linkedAccountId String?         @map("linked_account_id")
    linkedAccount   ChartOfAccount? @relation("CashboxLinkedAccount", fields: [linkedAccountId], references: [id])
    expenses        Expense[]
    payments Payment[]

    @@unique([tenantId, code])
    @@index([tenantId])
    @@map("cashboxes")
}

// ─── Payment ──────────────────────────────────────────────────────────────────
model Payment {
    id                String        @id @default(uuid())
    tenantId          String        @map("tenant_id")
    number            String
    type              PaymentType
    date              DateTime
    cashboxId         String        @map("cashbox_id")
    partyId           String?       @map("party_id")
    currencyId        String        @map("currency_id")
    fiscalPeriodId    String        @map("fiscal_period_id")
    amount            Decimal       @db.Decimal(18, 4)
    allocatedAmount   Decimal       @default(0) @map("allocated_amount") @db.Decimal(18, 4)
    unallocatedAmount Decimal       @default(0) @map("unallocated_amount") @db.Decimal(18, 4)
    status            PaymentStatus @default(DRAFT)
    notes             String?
    postedAt          DateTime?     @map("posted_at")
    postedBy          String?       @map("posted_by")
    cancelledAt       DateTime?     @map("cancelled_at")
    cancelledBy       String?       @map("cancelled_by")
    createdBy         String        @map("created_by")
    createdAt         DateTime      @default(now()) @map("created_at")
    updatedAt         DateTime      @updatedAt @map("updated_at")

    tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    cashbox      Cashbox             @relation(fields: [cashboxId], references: [id])
    party        Party?              @relation(fields: [partyId], references: [id])
    currency     Currency            @relation(fields: [currencyId], references: [id])
    fiscalPeriod FiscalPeriod        @relation(fields: [fiscalPeriodId], references: [id])
    allocations  PaymentAllocation[]

    @@unique([tenantId, number])
    @@index([tenantId])
    @@index([tenantId, status])
    @@map("payments")
}

// ─── Payment Allocation ───────────────────────────────────────────────────────
model PaymentAllocation {
    id        String   @id @default(uuid())
    tenantId  String   @map("tenant_id")
    paymentId String   @map("payment_id")
    invoiceId String   @map("invoice_id")
    amount    Decimal  @db.Decimal(18, 4)
    createdAt DateTime @default(now()) @map("created_at")

    payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
    invoice Invoice @relation(fields: [invoiceId], references: [id])

    @@index([tenantId])
    @@index([paymentId])
    @@map("payment_allocations")
}
