// ─── Invoice Direction Enum ───────────────────────────────────────────────────
enum InvoiceDirection {
    PURCHASE
    SALE
}

// ─── Invoice Status Enum ──────────────────────────────────────────────────────
enum InvoiceStatus {
    DRAFT
    POSTED
    CANCELLED
}

// ─── Invoice Type ─────────────────────────────────────────────────────────────
model InvoiceType {
    id           String           @id @default(uuid())
    tenantId     String           @map("tenant_id")
    code         String
    name         Json     @db.JsonB // LocalizedString: { ar: string; en?: string }
    direction    InvoiceDirection
    affectsStock Boolean          @default(true) @map("affects_stock")
    isActive     Boolean          @default(true) @map("is_active")
    createdAt    DateTime         @default(now()) @map("created_at")
    updatedAt    DateTime         @updatedAt @map("updated_at")

    tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    invoices Invoice[]

    @@unique([tenantId, code])
    @@index([tenantId])
    @@map("invoice_types")
}

// ─── Invoice ──────────────────────────────────────────────────────────────────
model Invoice {
    id             String        @id @default(uuid())
    tenantId       String        @map("tenant_id")
    invoiceTypeId  String        @map("invoice_type_id")
    number         String
    date           DateTime
    dueDate        DateTime?     @map("due_date")
    partyId        String        @map("party_id")
    warehouseId    String?       @map("warehouse_id")
    fiscalPeriodId String        @map("fiscal_period_id")
    currencyId     String        @map("currency_id")
    status         InvoiceStatus @default(DRAFT)
    subtotal       Decimal       @default(0) @db.Decimal(18, 4)
    discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(18, 4)
    taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(18, 4)
    total          Decimal       @default(0) @db.Decimal(18, 4)
    notes          String?
    postedAt       DateTime?     @map("posted_at")
    postedBy       String?       @map("posted_by")
    cancelledAt    DateTime?     @map("cancelled_at")
    cancelledBy    String?       @map("cancelled_by")
    createdBy      String        @map("created_by")
    createdAt      DateTime      @default(now()) @map("created_at")
    updatedAt      DateTime      @updatedAt @map("updated_at")

    tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    invoiceType        InvoiceType         @relation(fields: [invoiceTypeId], references: [id])
    party              Party               @relation(fields: [partyId], references: [id])
    warehouse          Warehouse?          @relation(fields: [warehouseId], references: [id])
    fiscalPeriod       FiscalPeriod        @relation(fields: [fiscalPeriodId], references: [id])
    currency           Currency            @relation(fields: [currencyId], references: [id])
    lines              InvoiceLine[]
    paymentAllocations PaymentAllocation[]

    @@unique([tenantId, number])
    @@index([tenantId])
    @@index([tenantId, status])
    @@map("invoices")
}

// ─── Invoice Line ─────────────────────────────────────────────────────────────
model InvoiceLine {
    id              String   @id @default(uuid())
    tenantId        String   @map("tenant_id")
    invoiceId       String   @map("invoice_id")
    itemId          String   @map("item_id")
    unitId          String   @map("unit_id")
    quantity        Decimal  @db.Decimal(18, 4)
    unitPrice       Decimal  @map("unit_price") @db.Decimal(18, 4)
    discountPercent Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)
    discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 4)
    taxPercent      Decimal  @default(0) @map("tax_percent") @db.Decimal(5, 2)
    taxAmount       Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 4)
    total           Decimal  @db.Decimal(18, 4)
    notes           String?
    sortOrder       Int      @default(0) @map("sort_order")

    invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
    item    Item    @relation(fields: [itemId], references: [id])
    unit    Unit    @relation(fields: [unitId], references: [id])

    @@index([tenantId])
    @@index([invoiceId])
    @@map("invoice_lines")
}
