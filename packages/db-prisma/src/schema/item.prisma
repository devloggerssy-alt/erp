enum FieldType {
    TEXT
    DATE
    NUMBER
    SELECT
    BOOLEAN
    MULTI_SELECT
}

// ─── Item ─────────────────────────────────────────────────────────────────────
model Item {
    id                  String   @id @default(uuid())
    tenantId            String   @map("tenant_id")
    code                String
    name                String
    barcode             String?
    categoryId          String   @map("category_id")
    baseUnitId          String   @map("base_unit_id")
    defaultSellingPrice Decimal? @map("default_selling_price") @db.Decimal(18, 4)
    latestPurchasePrice Decimal? @map("latest_purchase_price") @db.Decimal(18, 4)
    isActive            Boolean  @default(true) @map("is_active")
    createdAt           DateTime @default(now()) @map("created_at")
    updatedAt           DateTime @updatedAt @map("updated_at")

    tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    category        ItemCategory       @relation(fields: [categoryId], references: [id])
    baseUnit        Unit               @relation(fields: [baseUnitId], references: [id])
    warehouseItems  WarehouseItem[]
    stockBalances   StockBalance[]
    stockMovements  StockMovement[]
    invoiceLines    InvoiceLine[]
    stockCountLines StockCountLine[]
    customValues    CustomFieldValue[]

    @@unique([tenantId, code])
    @@index([tenantId])
    @@map("items")
}

model CustomField {
    id           String    @id @default(uuid())
    tenantId     String    @map("tenant_id")
    module       String
    name         String
    label        String
    type         FieldType
    defaultValue String?   @map("default_value") // For boolean true/false as string
    placeholder  String?
    options      String[] // For select field
    isRequired   Boolean   @default(false) @map("is_required")
    createdAt    DateTime  @default(now()) @map("created_at")

    values CustomFieldValue[]

    @@unique([tenantId, name, module])
    @@index([tenantId, module])
    @@map("custom_fields")
}

model CustomFieldValue {
    id       String @id @default(uuid())
    tenantId String @map("tenant_id")
    fieldId  String @map("field_id")
    itemId   String @map("item_id")
    value    String

    field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
    item  Item        @relation(fields: [itemId], references: [id])

    @@index([itemId])
    @@index([tenantId, itemId])
    @@index([fieldId, value])
    @@map("custom_field_values")
}
