// ─── Document Sequence ────────────────────────────────────────────────────────
model DocumentSequence {
    id           String   @id @default(uuid())
    tenantId     String   @map("tenant_id")
    documentType String   @map("document_type") // e.g. "PURCHASE_INVOICE", "SALES_INVOICE", "PAYMENT"
    prefix       String   // e.g. "PUR", "SAL", "PAY"
    nextNumber   Int      @default(1) @map("next_number")
    padding      Int      @default(5) // zero-pad length, e.g. 5 → 00001
    /// Optional branch reference — the deliberate seam for future per-branch
    /// numbering (docs/adr/0008). Numbering stays tenant-level in Phase 1.1.
    branchId     String?  @map("branch_id")
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
    defaultSalesForTenants Tenant[] @relation("TenantDefaultSalesSequence")

    @@unique([tenantId, documentType])
    @@index([tenantId])
    @@map("document_sequences")
}
