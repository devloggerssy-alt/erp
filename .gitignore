# API contract — generated by `pnpm generate` but intentionally committed
# (.ai/rules/packages.md): CI regenerates and fails on a non-empty diff.
# Do NOT ignore these:
#   apps/api/openapi.yaml
#   packages/api-contracts/types/index.ts

# Impeccable per-session hook cache (absolute local paths + session UUIDs).
# Note: .impeccable/design.json and .impeccable/live/config.json ARE tracked —
# they are shared project config, not machine state.
**/.impeccable/hook.cache.json
