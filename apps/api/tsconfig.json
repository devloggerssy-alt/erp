{
  "extends": "@devloggers/typescript-config/base.json",
  "compilerOptions": {
    // ── API-specific: NestJS decorators ──────────────────────────────────────
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    // ── API-specific: build output ───────────────────────────────────────────
    "target": "ES2023",
    "outDir": "./dist",
    "sourceMap": true,
    "removeComments": true,
    "incremental": true,
    // Private app — no consumers of its .d.ts. Keeps inferred Prisma types
    // (JsonValue etc.) out of declaration emit, where they aren't nameable.
    "declaration": false,
    "declarationMap": false,

    // ── API-specific: module resolution ──────────────────────────────────────
    "resolvePackageJsonExports": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
