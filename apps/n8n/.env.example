N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Damascus
TZ=Asia/Damascus

N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=replace-with-a-strong-password
N8N_ENCRYPTION_KEY=replace-with-a-stable-random-encryption-key
